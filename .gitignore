# DEV BRANCH gitignore — tracks the full source tree.
#
# (The `main` branch uses an allowlist .gitignore that intentionally publishes
# only themes/ + assets/. This `dev` branch is a private local-only snapshot
# of the full code: src/, scripts/, package.json, docs/, etc. NEVER push this
# branch to a public remote.)

# Dependencies
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Compiled plugin outputs (regenerable from src/ via npm run build).
# Ignore everything in plugins/ EXCEPT the hand-maintained shared helper .js files
# (BetterDiscordReactUtils.js, PluginMainLoader.js, etc.) which are real source with
# no src/ equivalent — those must be tracked. Compiled *.plugin.js stay ignored.
plugins/*
!plugins/*.js
plugins/*.plugin.js

# Repo memory — sensitive session/dev state, not for backup
memory/

# Lint / analysis reports (generated, large, ephemeral)
reports/
archlint-*.json
.archlint-cache/

# Cleanup buckets
_local/
.serena/
logs/

# Backup artifacts
backups/
**/backups/
.backup-*/
*.backup
*.bak
*.old
*.orig

# Dead-code analysis dumps (regenerable, large, ephemeral)
dead-symbols*.tsv
criticalhit-dead-*.txt

# Claude Code local config (per-machine)
.claude/

# Personal themes (don't snapshot)
themes/MyTheme.theme.css

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE files
.vscode/
.idea/
*.sublime-*
*.code-workspace

# Sensitive
.env
.env.local
.env.*.local
*.env
*.key
*.pem
*.cert
secrets/
credentials/
config.local.*

# Temporary
*.tmp
*.temp
*.log
*.cache
*.swp
*.swo
*~
.#*

# AI agent state dirs — never track (per forked-oss-backup-workflow memory)
.ocx/
.opencode/
# Added by code-review-graph
.code-review-graph/

# code-review-graph platform configs for tools not used in this repo
# (regenerable via `code-review-graph install --platform <name>`)
.codebuddy/
.cursor/
.cursorrules
.gemini/
.github/code-review-graph.instruction.md
.kiro/
.qoder/
.windsurfrules
CODEBUDDY.md
GEMINI.md
QODER.md
opencode.jsonc

# R writes this to CWD on any plot call; nothing to do with this project.
Rplots.pdf
